{
  "Urls": "http://127.0.0.1:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "SecretKey": "CHANGE-ME-IN-PRODUCTION-32CHARS-MIN",
    "Issuer": "xiaopacai-web",
    "Audience": "xiaopacai-client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Database": {
    "Path": "Data/xiaopacai.db",
    "Password": ""
  },
  "P2P": {
    "ListenPort": 9527,
    "TlsMinVersion": "1.2",
    "CertPath": "Data/certs/server.pfx",
    "CertPassword": ""
  },
  "WebApp": {
    "StaticFilesPath": "../web/dist"
  },
  "ReverseProxy": {
    "Enabled": false
  }
}
